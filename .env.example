# Save as .env in the project copy you launch, then restart the API.
# Separate Git worktrees do not share .env files.
# Jira cloud URL, no trailing slash
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian account email used for API auth
JIRA_EMAIL=your-email@example.com

# One Jira API token shared by all saved sites; numbered instance tokens are ignored.
JIRA_API_TOKEN=replace-with-token

# Optional: multiple Jira sites (max 5). If unset, single JIRA_* above is used (legacy).
# Startup seeds the registry only when at least one JIRA_INSTANCE_N_BASE_URL is set.
# Bare JIRA_* alone keeps the registry empty and uses data/workweek.sqlite.
# Saved sites provide their own URL/email; JIRA_API_TOKEN always comes from the server environment.
# JIRA_INSTANCE_1_NAME=Primary
# JIRA_INSTANCE_1_BASE_URL=https://your-domain.atlassian.net
# JIRA_INSTANCE_1_EMAIL=you@example.com
# JIRA_INSTANCE_2_NAME=Other
# JIRA_INSTANCE_2_BASE_URL=
# JIRA_INSTANCE_2_EMAIL=

# Local proxy port
API_PORT=8787

# ── Chat & reports (explicit opt-in — no default provider) ───────────────────
# ── Managed / Company AI (default when set) ─────────────────────────────────
# OpenAI-compatible company gateway (Databricks, Azure OpenAI, GitHub Models, …)
# MANAGED_AI_BASE_URL=https://<company-gateway>/v1
# MANAGED_AI_API_KEY=
# MANAGED_AI_MODEL=
# Optional host lock: AI_MODE=managed | local
#
# Chat and reports use the same LLM family unless you set REPORT_PROVIDER.
# Supported providers: anthropic | openai | ollama | databricks (any can power chat + reports).
#
# OpenAI-compatible APIs (Databricks, Azure OpenAI, LiteLLM, vLLM, etc.):
#   CHAT_PROVIDER=openai + OPENAI_API_KEY + OPENAI_BASE_URL + OPENAI_MODEL
#
# Leave CHAT_PROVIDER unset to disable chat until configured.
# Use CHAT_PROVIDER=disabled to turn chat off explicitly.

# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Databricks Model Serving (OpenAI-compatible):
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=<databricks-personal-access-token>
# OPENAI_BASE_URL=https://<workspace-host>/serving-endpoints/<endpoint-name>/invocations/v1
# OPENAI_MODEL=<served-model-name>

# CHAT_PROVIDER=databricks
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_TOKEN=<databricks-personal-access-token>
# DATABRICKS_ENDPOINT=<serving-endpoint-name>
# REPORT_DATABRICKS_ENDPOINT=   # optional report-only endpoint

# CHAT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_REPORT_MODEL=llama3.3:70b

# ── Optional: different provider or credentials for reports only ─────────────
# REPORT_PROVIDER=openai
# REPORT_OPENAI_API_KEY=
# REPORT_OPENAI_BASE_URL=
# REPORT_OPENAI_MODEL=
# REPORT_ANTHROPIC_API_KEY=
# REPORT_ANTHROPIC_BASE_URL=
# REPORT_ANTHROPIC_MODEL=

# ── Optional limits and timeouts (defaults shown) ───────────────────────────
# ATTACHMENT_MAX_MB=250            # per-file attachment limit; Jira's own limit still applies
# LLM_TIMEOUT_MS=180000            # Anthropic / OpenAI / Managed AI requests
# OLLAMA_TIMEOUT_MS=600000         # Ollama requests
# AI_DRAFT_TIMEOUT_MS=120000       # Create Issue AI Draft

# ── Rovo (opt-in — only if your org has Rovo MCP) ─────────────────────────────
# CHAT_PROVIDER=rovo
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# CHAT_OAUTH_REDIRECT_URI=http://localhost:8787/api/chat/auth/callback

# ── Logging ───────────────────────────────────────────────────────────────────
# Controls server-side log verbosity. Default: info
# Levels (least → most verbose): error | warn | info | debug
#
# info  — HTTP requests, refresh/report start+complete, preset mutations (default)
# debug — adds every individual Jira API call (method, URL, status)
# warn  — HTTP 4xx responses and configuration warnings only
# error — failures only
#
# LOG_LEVEL=info

# ── Shared team data (PostgreSQL) — optional ─────────────────────────────────
# Local SQLite works without this. Set only an explicitly approved database URL.
# Run npm run team-db:migrate before using shared data. Remote hosts require verified TLS.
# TEAM_PRIORITY_DATABASE_URL=postgresql://USER:PASSWORD@db.example.test/docket
# TEAM_PRIORITY_DATABASE_CA_FILE=/absolute/path/to/company-root-ca.pem

# Finite Rovo MCP deadline, including streamed response body (increase for longer answers).
ROVO_REQUEST_TIMEOUT_MS=30000

# Combined Open Work: positive integers; invalid values use defaults.
# Max rows per saved entry (default/cap 5000); interrupted/capped lists are partial.
DOCKET_OPEN_WORK_MAX_ROWS_PER_SITE=5000
# Collection deadline includes all selected Jira searches/body reads (cap 600000 ms).
DOCKET_OPEN_WORK_TIMEOUT_MS=120000
