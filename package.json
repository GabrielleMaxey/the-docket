{
  "name": "task-manager",
  "private": true,
  "version": "0.0.0",
  "description": "The Docket — Jira-integrated IC and PM work management",
  "author": "The Docket Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "check:node": "node scripts/check-node-version.cjs",
    "preinstall": "node scripts/check-node-version.cjs",
    "postinstall": "electron-builder install-app-deps",
    "check:jira-client-exports": "node scripts/check-jira-client-exports.cjs",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --test tests/**/*.test.mjs",
    "seed:presets": "node scripts/seed-epic-presets.mjs",
    "preseed:presets": "npm run check:node && npm rebuild better-sqlite3",
    "prebuild": "npm run check:node && npm run check:jira-client-exports",
    "predev": "npm run check:node",
    "predev:ui": "npm run check:node",
    "predev:api": "npm run check:node && npm rebuild better-sqlite3",
    "predev:electron": "npm run check:node && npm run desktop:rebuild-native",
    "predev:all": "npm run check:node",
    "predesktop:dev": "npm run check:node",
    "predesktop:doctor": "npm run check:node",
    "prepreview": "npm run check:node",
    "dev": "vite",
    "dev:ui": "vite",
    "dev:api": "node server/jiraProxy.mjs",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev:all": "concurrently -n ui,api \"npm:dev:ui\" \"npm:dev:api\"",
    "desktop:dev": "concurrently -k -n ui,electron \"npm:dev:ui\" \"npm:dev:electron\"",
    "desktop:rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "desktop:doctor": "npm run desktop:rebuild-native && npm run desktop:dev",
    "desktop:generate-icons": "node -e \"require('fs').mkdirSync('build/icons', { recursive: true })\" && icon-gen -i public/the-docket-favicon.svg -o build/icons --ico --icns --ico-name icon --icns-name icon",
    "build": "vite build",
    "desktop:build": "npm run build",
    "desktop:pack": "npm run desktop:generate-icons && npm run build && electron-builder --dir",
    "desktop:dist": "npm run desktop:generate-icons && npm run build && electron-builder --publish never",
    "desktop:dist:mac": "npm run desktop:generate-icons && npm run build && electron-builder --mac dmg --publish never",
    "desktop:dist:win": "npm run desktop:generate-icons && npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.gmaxey.taskmanager",
    "productName": "The Docket",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "server/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^6.21.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.8.0",
    "react-router-dom": "^7.18.2",
    "react-scroll": "^1.9.3",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "styled-components": "^5.3.9"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "icon-gen": "^2.1.0",
    "vite": "^8.0.16",
    "wait-on": "^8.0.1"
  }
}
